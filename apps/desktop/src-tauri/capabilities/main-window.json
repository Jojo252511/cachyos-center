{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main-window",
  "description": "Permissions of the main window: exactly the application commands of the IPC contract and event listening. No shell, filesystem or process permissions.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-get-app-info",
    "allow-get-dashboard",
    "allow-get-system-info",
    "allow-get-hyprland-info",
    "allow-get-updates",
    "allow-check-updates",
    "allow-list-installed",
    "allow-search-packages",
    "allow-get-package-details",
    "allow-list-repositories",
    "allow-get-health",
    "allow-get-news",
    "allow-acknowledge-news",
    "allow-get-activity",
    "allow-get-settings",
    "allow-save-settings",
    "allow-get-auto-update-status",
    "allow-get-diagnostic-report",
    "allow-get-mcp-setup",
    "allow-plan-install",
    "allow-plan-remove",
    "allow-start-upgrade",
    "allow-start-install",
    "allow-start-remove",
    "allow-set-auto-update-policy",
    "allow-cancel-operation",
    "allow-get-operation",
    "allow-get-operation-log",
    "allow-get-current-operation",
    "allow-open-external",
    "allow-reveal-config-file",
    "allow-write-clipboard"
  ]
}
