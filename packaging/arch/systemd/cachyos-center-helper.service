[Unit]
Description=cachyos-center privileged helper
Documentation=https://github.com/Jojo252511/cachyos-center/blob/main/docs/sicherheitsmodell.md

[Service]
Type=dbus
BusName=org.cachyos_center.Packages1
ExecStart=/usr/lib/cachyos-center/cachyos-center-helper daemon
# pacman itself runs in transient units (systemd-run) and is therefore not
# affected by the restrictions below or by a restart of the helper.
StateDirectory=cachyos-center
StateDirectoryMode=0755
LogsDirectory=cachyos-center
LogsDirectoryMode=0755
ProtectSystem=full
ReadWritePaths=/etc/cachyos-center /etc/systemd/system/cachyos-center-preflight.timer.d
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
